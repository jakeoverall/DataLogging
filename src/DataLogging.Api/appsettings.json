{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "UseMockData": true
  },
  "DeviceRegistration": {
    "Provider": "file",
    "FilePath": "config/device-registry.json"
  },
  "Storage": {
    "Provider": "file",
    "FilePath": "data/logs.ndjson",
    "MaxFileSizeBytes": 5242880,
    "MaxRetainedFiles": 5
  },
  "MockHardware": {
    "NDevices": 3,
    "EmitFrequency": "00:00:01",
    "LogRaw": false,
    "BufferCapacity": 64
  }
}
